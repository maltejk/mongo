# Build container for SCons-era (5.0/6.0/7.0) and for the packaging step.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc-11 g++-11 python3 python3-dev python3-pip python3-venv python3-git \
        libssl-dev libcurl4-openssl-dev liblzma-dev libgssapi-krb5-2 libsasl2-dev \
        git curl ca-certificates pkg-config \
        dpkg-dev apt-utils debhelper fakeroot binutils gawk lsb-release \
    && rm -rf /var/lib/apt/lists/*
ENV CC=gcc-11 CXX=g++-11
