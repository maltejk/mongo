# Sourced by the scripts in this directory.
SERVER_SERIES=4.4
SERVER_VERSION=4.4.31
BUILD_SYSTEM=scons
BUILD_CONTAINER=ubuntu20.04-openssl111
BASE_IMAGE=mongo:4.4
# 4.4 has no -march=sandybridge default, so the stock x86_64 code generation already runs on the C2758.
# OpenSSL 1.1.1 is linked statically (see build-env/Dockerfile.ubuntu20.04-openssl111).
SCONS_FLAGS=(--release --disable-warnings-as-errors CC=gcc-9 CXX=g++-9 CPPPATH=/opt/openssl-1.1/include LIBPATH=/opt/openssl-1.1/lib)
