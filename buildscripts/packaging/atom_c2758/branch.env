# Sourced by the scripts in this directory.
SERVER_SERIES=7.0
SERVER_VERSION=7.0.45
BUILD_SYSTEM=scons
BUILD_CONTAINER=ubuntu22.04
# Built on ubuntu2404 .deb (see build_image.sh / Dockerfile), not layered
# raw onto the official mongo:7.0 image, for consistency with 5.0/6.0.
BASE_IMAGE=ubuntu:24.04
# -sandybridge removes the default -march=sandybridge; an explicit -march in CCFLAGS then sets the target.
SCONS_FLAGS=(--release --disable-warnings-as-errors --experimental-optimization=-sandybridge CC=gcc-11 CXX=g++-11 "CCFLAGS=-march=silvermont -mtune=silvermont")
