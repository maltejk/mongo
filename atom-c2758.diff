@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Build the Atom C2758 docker image on top of the official mongo image.
+# Usage: build_image.sh [-b BASE_IMAGE] [-t TAG] [-s]
+#   -b  official base image (default mongo:8.0)
+#   -t  resulting tag (default mongo-atom-c2758:local)
+#   -s  skip the bazel build, reuse bazel-bin/dist-stripped.tgz
+set -euo pipefail
+
+repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
+base="mongo:8.0"
+tag="mongo-atom-c2758:local"
+skip_build=0
+while getopts "b:t:s" opt; do
+    case "$opt" in
+    b) base="$OPTARG" ;;
+    t) tag="$OPTARG" ;;
+    s) skip_build=1 ;;
+    *) exit 2 ;;
+    esac
+done
+
+cd "$repo"
+if [[ $skip_build -eq 0 ]]; then
+    # shellcheck disable=SC2086
+    bazel build --config=opt --config=atom_c2758 ${BAZEL_FLAGS:-} archive-dist-stripped
+fi
+
+# bazel-bin is a symlink; resolve it so the build context is a real directory.
+docker build --platform linux/amd64 \
+    -f buildscripts/packaging/atom_c2758/Dockerfile \
+    --build-arg BASE_IMAGE="$base" \
+    --build-context dist="$(readlink -f bazel-bin)" \
+    -t "$tag" .
diff --git a/buildscripts/packaging/atom_c2758/check_no_avx.sh b/buildscripts/packaging/atom_c2758/check_no_avx.sh
new file mode 100755
index 00000000..7943fc89
--- /dev/null
+++ b/buildscripts/packaging/atom_c2758/check_no_avx.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+# Fails if a binary contains AVX/AVX2 (VEX-encoded) instructions outside the
+# runtime-dispatched mozjs AVX2 routines, i.e. code that would SIGILL on an
+# Atom C2758 (Silvermont, no AVX).
+set -euo pipefail
+
+if [[ $# -lt 1 ]]; then
+    echo "usage: $0 <elf> [<elf>...]" >&2
+    exit 2
+fi
+
+rc=0
+for bin in "$@"; do
+    # Allowed: functions gated by mozilla::supports_avx2() (SIMD_avx2.cpp).
+    offenders=$(objdump -d --no-show-raw-insn -C "$bin" | awk '
+        /^[0-9a-f]+ <.*>:$/ { fn = $0; next }
+        $2 ~ /^v[a-z0-9]+/ && $2 !~ /^(verr|verw|vmcall|vmclear|vmlaunch|vmptrld|vmptrst|vmread|vmresume|vmwrite|vmxoff|vmxon|vmmcall|vmload|vmrun|vmsave)/ {
+            if (fn !~ /AVX2|mozilla::(Cast256|GetAs|AlignDown32|AlignUp32|CmpEq|Load64Bits|Check4x)/) bad[fn]++
+        }
+        END { for (f in bad) print bad[f], f }
+    ' | sort -rn | head -20)
+    if [[ -n "$offenders" ]]; then
+        echo "FAIL: $bin contains AVX instructions outside AVX2-gated code:" >&2
+        echo "$offenders" >&2
+        rc=1
+    else
+        echo "OK: $bin has no ungated AVX instructions"
+    fi
+done
+exit $rc
